package com.example.droolspoc.rules

import com.example.droolspoc.model.ValidationContext

// Default state of a transaction is valid = true (allowed). This rule flips it
// to blocked when ALL of the following hold:
//   - currency is BDT
//   - the product is debit-restricted (drRes == 1)
//   - the amount exceeds the user's configured limit
//
// If it does not fire, the transaction stays allowed.

rule "Block over-limit debit-restricted BDT transaction"
    when
        $ctx : ValidationContext(
            transaction.currency == "BDT",
            product.drRes == 1,
            transaction.amount > userLimit.limit
        )
    then
        $ctx.getTransaction().setValid(false);
        $ctx.getTransaction().setPermissionDenied(true);
        $ctx.getTransaction().setValidationMessage(
            "Blocked: amount exceeds limit on a debit-restricted BDT account");
end
