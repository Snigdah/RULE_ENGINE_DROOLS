<?xml version="1.0" encoding="UTF-8" ?>
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/" xmlns:feel="https://www.omg.org/spec/DMN/20230324/FEEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/" xmlns:kie="https://kie.org/dmn/extensions/1.0" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" namespace="https://leads-bd.com/dmn/transaction" name="TransactionValidation" id="def_transaction_validation">
  <inputData id="in_blocked" name="blocked">
    <variable id="v_blocked" name="blocked" typeRef="boolean" />
  </inputData>
  <inputData id="in_amount" name="amount">
    <variable id="v_amount" name="amount" typeRef="number" />
  </inputData>
  <inputData id="in_currency" name="currency">
    <variable id="v_currency" name="currency" typeRef="string" />
  </inputData>
  <inputData id="in_userLimit" name="userLimit">
    <variable id="v_userLimit" name="userLimit" typeRef="number" />
  </inputData>
  <inputData id="in_productDrRes" name="productDrRes">
    <variable id="v_productDrRes" name="productDrRes" typeRef="number" />
  </inputData>
  <decision id="dec_blockedUserRule" name="blockedUserRule">
    <variable id="v_r1" name="blockedUserRule" typeRef="string" />
    <informationRequirement id="ir_r1_blocked">
      <requiredInput href="#in_blocked" />
    </informationRequirement>
    <literalExpression id="le_r1">
      <text>if blocked = true then &quot;Blocked: user is blocked&quot; else null</text>
    </literalExpression>
  </decision>
  <decision id="dec_overLimitRule" name="overLimitRule">
    <variable id="v_r2" name="overLimitRule" typeRef="string" />
    <informationRequirement id="ir_r2_currency">
      <requiredInput href="#in_currency" />
    </informationRequirement>
    <informationRequirement id="ir_r2_drres">
      <requiredInput href="#in_productDrRes" />
    </informationRequirement>
    <informationRequirement id="ir_r2_amount">
      <requiredInput href="#in_amount" />
    </informationRequirement>
    <informationRequirement id="ir_r2_limit">
      <requiredInput href="#in_userLimit" />
    </informationRequirement>
    <literalExpression id="le_r2">
      <text>if currency = &quot;BDT&quot; and productDrRes = 1 and amount &gt; userLimit then &quot;Blocked: amount exceeds limit on a debit-restricted BDT account&quot; else null</text>
    </literalExpression>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="_813A40DB-1AE9-4BF4-975A-2C6E7402A578" name="Default DRD" useAlternativeInputDataShape="false">
      <di:extension>
        <kie:ComponentsWidthsExtension>
          <kie:ComponentWidths />
        </kie:ComponentsWidthsExtension>
      </di:extension>
      <dmndi:DMNShape id="_B2284E61-CA69-42D8-A6B3-59677DE38B1C" dmnElementRef="in_blocked">
        <dc:Bounds x="112" y="292" width="160" height="80" />
      </dmndi:DMNShape>
