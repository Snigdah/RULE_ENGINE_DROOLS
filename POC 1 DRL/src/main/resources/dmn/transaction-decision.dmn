        <dc:Bounds x="912" y="292" width="160" height="80" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="_1027CAB0-C8A0-43E6-9DA3-41459C6506AE" dmnElementRef="in_userLimit">
        <dc:Bounds x="692" y="292" width="160" height="80" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="_F03024D1-D81E-4B48-9B59-DCFE950AC668" dmnElementRef="in_productDrRes">
