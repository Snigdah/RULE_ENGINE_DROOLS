      </dmndi:DMNShape>
      <dmndi:DMNShape id="_48DCCD1C-CC69-47D7-BFAC-8FE2B6BF2CFA" dmnElementRef="dec_blockedUserRule">
        <dc:Bounds x="112" y="112" width="160" height="80" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="_92DCFA53-B615-4EEA-B7D1-2170A948E4BA" dmnElementRef="dec_overLimitRule">
        <dc:Bounds x="692" y="112" width="160" height="80" />
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="_68EF68B9-F4DC-4CE1-8396-DAB13F565C5B" dmnElementRef="ir_r1_blocked" sourceElement="_B2284E61-CA69-42D8-A6B3-59677DE38B1C" targetElement="_48DCCD1C-CC69-47D7-BFAC-8FE2B6BF2CFA">
        <di:waypoint x="192" y="292" />
        <di:waypoint x="192" y="192" />
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="_2BB49A9B-F7EC-44EB-B1CF-6E36539BBCE0" dmnElementRef="ir_r2_currency" sourceElement="_BE160263-3C16-432C-B763-9E97A11D9040" targetElement="_92DCFA53-B615-4EEA-B7D1-2170A948E4BA">
        <di:waypoint x="992" y="292" />
